APP_ENV=development
APP_NAME=AutoCut AI
DEBUG=false
API_PREFIX=/api/v1

# PostgreSQL is the only primary database. Add credentials locally if your instance needs them.
DATABASE_URL=postgresql+asyncpg://localhost/autocut
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Redis is used for Celery delivery, rate limits, coordination, and cache-aside reads.
REDIS_URL=redis://localhost:6379/0

# Add the Better Auth JWT plugin issuer, audience, and public JWKS URL when configured.
# Protected endpoints return an error while these are blank.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_ALGORITHMS=["EdDSA","RS256","ES256"]

CORS_ORIGINS=[]
MEDIA_STORAGE_ROOT=./var/media
MAX_UPLOAD_SIZE_MB=1024
MAX_PROJECT_DURATION_SECONDS=3600
MAX_CONCURRENT_RENDERS=2
MAX_PROJECTS_PER_USER=100
MAX_STORAGE_BYTES=53687091200
MAX_TIMELINE_ITEMS=500
MAX_OUTBOX_ATTEMPTS=10
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_CHUNK_SIZE_BYTES=1048576
REQUEST_MAX_BYTES=1048576

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MLT_RENDER_BINARY=melt
PROCESS_TIMEOUT_SECONDS=1800
JOB_LEASE_SECONDS=90
MAX_JOB_RETRIES=3
DEFAULT_PREVIEW_PRESET=preview
DECODE_CHECK=true

CACHE_TTL_SECONDS=60
EXPENSIVE_REQUESTS_PER_MINUTE=20
LOG_LEVEL=INFO

# Object storage: supply your R2 settings locally. No credentials are included.
STORAGE_BACKEND=r2
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
DATABASE_SCHEMA=public
CELERY_QUEUE=autocut-main
MAX_MEDIA_PROCESSES=4
MAX_RENDER_SECONDS_PER_MONTH=36000
MAX_UPLOAD_SESSIONS_PER_USER=5
